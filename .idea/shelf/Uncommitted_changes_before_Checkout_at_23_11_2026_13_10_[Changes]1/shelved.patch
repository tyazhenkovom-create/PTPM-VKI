+class Converter:
+    """Класс с одним статическим методом преобразования float -> int."""
+
+    @staticmethod
+    def do(x: float) -> int:
+        """
+        Преобразует вещественное число (точность 1 знак после запятой)
+        в целое по кусочно-заданному алгоритму.
+
+        :raises ValueError: если x == 0.0
+        """
+        if x >= 100.7:
+            return 1000
+        if x > 0:
+            return int(x)
+        if x == 0.0:
+            raise ValueError("x не может быть равен 0.0")
+        if x >= -30.4:
+            return int(x) - 5
+        # x <= -30.5
+        return -2000
